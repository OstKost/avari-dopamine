# Environment: local | staging | production
ENV=local

# HTTP Server
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
POSTGRES_USER=dopamine
POSTGRES_PASSWORD=dopamine_secret
POSTGRES_DB=dopamine_market
DATABASE_URL=postgres://dopamine:dopamine_secret@localhost:5432/dopamine_market?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dopamine-market-api

# Graylog / Logging
LOG_LEVEL=info
GRAYLOG_HOST=
GRAYLOG_PORT=12201
GRAYLOG_PASSWORD_SECRET=some_secret_at_least_16_characters_long
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# Auth (JWT)
AUTH_JWT_SECRET=dev-secret-change-in-production-min32bytes
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# Payment: mock | yookassa
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SUCCESS_RATE=0.95
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
